.vs/
Debug/
*.vcxproj.user

# Root-level documents and presentation assets are not tracked.
# (SUMMARY/*.md is intentionally tracked -- only root-level *.md is ignored.)
/*.md
/*.ppt
/*.pptx
/*.png

# EPFL benchmark output -- regenerated by tests/epfl/run_compare.py.
# We keep the .gitkeep placeholder and the README, but ignore the
# per-bench scratch directories and the auto-generated report files.
tests/epfl/results/*/
tests/epfl/results/epfl_results.*

# EPFL benchmark dataset clone -- pulled via git submodule or
# git clone; not committed into this repo.
tests/epfl/lsils_benchmarks/
