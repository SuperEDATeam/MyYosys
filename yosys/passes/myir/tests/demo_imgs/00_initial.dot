digraph "_demo_all_opts" {
  rankdir=LR;
  label="demo_all_opts";
  node [fontname="Helvetica", fontsize=10];
  edge [fontsize=8];

  "w__a" [label="a\n1 bit", shape=octagon, style=filled, fillcolor=lightblue];
  "w__ab" [label="ab\n1 bit", shape=ellipse];
  "w__ac" [label="ac\n1 bit", shape=ellipse];
  "w__b" [label="b\n1 bit", shape=octagon, style=filled, fillcolor=lightblue];
  "w__c" [label="c\n1 bit", shape=octagon, style=filled, fillcolor=lightblue];
  "w__d" [label="d\n1 bit", shape=octagon, style=filled, fillcolor=lightblue];
  "w__dead" [label="dead\n1 bit", shape=ellipse];
  "w__din" [label="din\n4 bit", shape=octagon, style=filled, fillcolor=lightblue];
  "w__en" [label="en\n1 bit", shape=ellipse];
  "w__eq" [label="eq\n1 bit", shape=ellipse];
  "w__fac" [label="fac\n1 bit", shape=ellipse];
  "w__k0" [label="k0\n1 bit", shape=ellipse];
  "w__k1" [label="k1\n1 bit", shape=ellipse];
  "w__msel" [label="msel\n1 bit", shape=ellipse];
  "w__y_cat" [label="y_cat\n8 bit", shape=octagon, style=filled, fillcolor=lightyellow];
  "w__y_main" [label="y_main\n1 bit", shape=octagon, style=filled, fillcolor=lightyellow];
  "w__y_sh1" [label="y_sh1\n1 bit", shape=octagon, style=filled, fillcolor=lightyellow];
  "w__y_sh2" [label="y_sh2\n1 bit", shape=octagon, style=filled, fillcolor=lightyellow];
  "w__y_shift" [label="y_shift\n4 bit", shape=octagon, style=filled, fillcolor=lightyellow];
  "c_2'00" [label="2'00", shape=diamond, style=filled, fillcolor=lightgray];
  "c_2'11" [label="2'11", shape=diamond, style=filled, fillcolor=lightgray];

  "e_0" [label="Eq", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__din" -> "e_0";
  "w__din" -> "e_0";
  "e_0" -> "w__eq";
  "e_1" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__a" -> "e_1";
  "w__b" -> "e_1";
  "e_1" -> "w__ab";
  "e_2" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__a" -> "e_2";
  "w__c" -> "e_2";
  "e_2" -> "w__ac";
  "e_3" [label="Or", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__ab" -> "e_3";
  "w__ac" -> "e_3";
  "e_3" -> "w__fac";
  "e_4" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__a" -> "e_4";
  "w__d" -> "e_4";
  "e_4" -> "w__dead";
  "e_5" [label="Mux", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__dead" -> "e_5";
  "w__fac" -> "e_5";
  "w__eq" -> "e_5";
  "e_5" -> "w__msel";
  "e_6" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__msel" -> "e_6";
  "w__en" -> "e_6";
  "e_6" -> "w__y_main";
  "e_7" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__b" -> "e_7";
  "w__c" -> "e_7";
  "e_7" -> "w__y_sh1";
  "e_8" [label="And", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__b" -> "e_8";
  "w__c" -> "e_8";
  "e_8" -> "w__y_sh2";
  "e_9" [label="Add", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "w__din" -> "e_9";
  "w__din" -> "e_9";
  "e_9" -> "w__y_shift";
  "e_10" [label="Concat", shape=box, style="rounded,filled", fillcolor="#f0e0d0"];
  "c_2'11" -> "e_10";
  "c_2'00" -> "e_10";
  "w__din" -> "e_10";
  "e_10" -> "w__y_cat";
  "c_1'1" -> "w__k0" [style=dashed, color=gray];
  "w__k0" -> "w__k1" [style=dashed, color=gray];
  "w__k1" -> "w__en" [style=dashed, color=gray];
}
