# Test dead-branch elimination in mux trees
read_verilog passes/myir/tests/muxtree_test.v
myir_import
echo "=== Before myir_opt_muxtree ==="
myir_dump
myir_opt_muxtree
echo "=== After myir_opt_muxtree ==="
myir_dump
myir_opt_clean
echo "=== After myir_opt_clean ==="
myir_dump
myir_export
write_verilog muxtree_out.v
