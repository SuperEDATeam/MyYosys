# Full optimisation pipeline on rewrite_test.v.
#
# This script demonstrates two equivalent ways to drive the MyIR
# optimisation stack:
#
#   Usage A (recommended): one-shot via the new iris_opts command.
#   Usage B (debug):       same chain spelled out by hand.
#
# Compare the two output dumps to verify they converge to the same IR.

# ------------------------------------------------------------------
# Usage A: one-shot via iris_opts.
# ------------------------------------------------------------------
read_verilog passes/myir/tests/rewrite_test.v
iris_import

log "=== Initial IR ==="
iris_dump

log "=== After iris_opts -fixpoint -stats -k 4 ==="
iris_opts -fixpoint -stats -k 4
iris_dump

iris_export
write_verilog all_opts_out.v

# ------------------------------------------------------------------
# Usage B: hand-written pipeline (reference / debug aid).
# ------------------------------------------------------------------
design -reset
read_verilog passes/myir/tests/rewrite_test.v
iris_import

log "=== Manual pipeline reference ==="
iris_opt_const
iris_opt_expr
iris_opt_const
iris_opt_muxtree
iris_opt_expr
iris_rewrite -k 4 -stats
iris_opt_share
iris_opt_clean
iris_dump
