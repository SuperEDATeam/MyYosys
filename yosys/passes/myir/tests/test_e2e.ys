# End-to-end MyIR test script
# Usage:  yosys < test_e2e.ys   (or run inside Yosys shell line by line)

log "=== Step 1: Read Verilog ==="
read_verilog passes/myir/tests/carry.v

log "=== Step 2: Import to MyIR ==="
iris_import

log "=== Step 3: Dump MyIR (before optimisation) ==="
iris_dump

log "=== Step 4: Run optimisations ==="
iris_opt_share
iris_opt_muxtree
iris_rewrite
iris_opt_const
iris_opt_expr
iris_opt_const
iris_opt_clean

log "=== Step 5: Dump MyIR (after optimisation) ==="
iris_dump

log "=== Step 6: Generate DOT visualisation ==="
# Usage A: generate files only (non-interactive / CI-friendly)
iris_show -o carry_myir.dot -fmt png

# Usage B (commented): generate AND open in default viewer in one go
# iris_show -o carry_myir.dot -fmt png -view

# Usage C (commented): open the already-generated image later, without
# re-running Graphviz
# iris_view carry_myir.png

log "=== Step 7: Export back to RTLIL ==="
iris_export

log "=== Step 8: Write output Verilog ==="
write_verilog carry_out.v

log "=== Done! Check carry_out.v and carry_myir.dot ==="
