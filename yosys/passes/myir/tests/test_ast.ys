# End-to-end test for AST-based MyIR import
# Usage:  yosys < test_ast.ys

log "===== Test 1: Combinational logic (carry.v) via AST ====="
read_verilog passes/myir/tests/carry.v
iris_ast_import
iris_dump
design -reset

log "===== Test 2: If/Else (mux_ifelse.v) via AST ====="
read_verilog passes/myir/tests/mux_ifelse.v
iris_ast_import
iris_dump
# Two-step workflow: generate now, view later on demand with iris_view
iris_show -o mux_ifelse_ast.dot -fmt png
# iris_view mux_ifelse_ast.png
design -reset

log "===== Test 3: Case (mux_case.v) via AST ====="
read_verilog passes/myir/tests/mux_case.v
iris_ast_import
iris_dump
# One-step workflow: generate and pop up the default image viewer
iris_show -o mux_case_ast.dot -fmt png
# iris_show -o mux_case_ast.dot -fmt png -view
design -reset

log "===== Test 4: DFF with async reset (dff_test.v) via AST ====="
read_verilog passes/myir/tests/dff_test.v
iris_ast_import
iris_dump
iris_show -o dff_ar_ast.dot -fmt png
# iris_view dff_ar_ast.png
design -reset

log "===== Test 5: Compare AST vs RTLIL route (carry.v) ====="
read_verilog passes/myir/tests/carry.v
log "--- AST route ---"
iris_ast_import
iris_dump
log "--- RTLIL route ---"
iris_import
iris_dump

log "===== All AST tests done! ====="
