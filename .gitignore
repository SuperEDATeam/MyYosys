# ---- IDE / editor local state ----
.vs/
.idea/
*.vcxproj.user

# ---- Visual Studio build output (anchored to the build locations only,
#      so the yosys source subtree -- e.g. libs/zlib/win32 -- is untouched) ----
# Final binaries: <root>/Debug, <root>/Release, <root>/x64/<config>
# Intermediates : <root>/MyVSYosys/<config>
/Debug/
/Release/
/x64/
/Win32/
/MyVSYosys/Debug/
/MyVSYosys/Release/
/MyVSYosys/x64/
/MyVSYosys/Win32/

# ---- Root-level documents and presentation assets are not tracked. ----
# (SUMMARY/*.md is intentionally tracked -- only root-level *.md is ignored.)
/*.md
/*.ppt
/*.pptx
/*.png

# ---- Intentionally TRACKED (do NOT ignore) ----
# tests/epfl/lsils_benchmarks/  -> EPFL benchmark dataset (vendored)
# tests/epfl/results/           -> comparison reports + per-bench logs
# These are committed so the dataset and experimental results travel with
# the repo.  The dataset's own nested .git has been removed so its files are
# tracked as regular content rather than a git submodule/gitlink.
